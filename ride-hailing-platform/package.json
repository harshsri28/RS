{
  "name": "ride-hailing-platform",
  "version": "1.0.0",
  "description": "Multi-tenant ride-hailing platform foundation",
  "main": "src/cmd/api.js",
  "scripts": {
    "start": "node src/cmd/api.js",
    "dev": "nodemon src/cmd/api.js",
    "worker": "node src/cmd/worker.js",
    "worker:dev": "nodemon src/cmd/worker.js",
    "frontend": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "test": "jest",
    "test:phase2": "bash test_phase2.sh",
    "test:e2e": "bash test/e2e/ride_flow_test.sh",
    "test:load": "echo 'Install locust: pip install locust && locust -f test/load/locustfile.py --host=http://localhost:8080'",
    "docker:dev": "docker-compose up -d",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:stop": "docker-compose down"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mysql2": "^3.6.1",
    "knex": "^3.0.1",
    "uuid": "^9.0.1",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "pino": "^8.15.1",
    "pino-pretty": "^10.2.0",
    "cors": "^2.8.5",
    "amqplib": "^0.10.3",
    "@temporalio/client": "^1.8.6",
    "@temporalio/worker": "^1.8.6",
    "@temporalio/workflow": "^1.8.6",
    "ioredis": "^5.3.2",
    "prom-client": "^15.1.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0"
  },
  "type": "module"
}
